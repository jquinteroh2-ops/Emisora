<?xml version="1.0" encoding="UTF-8"?>
<!--
    Descriptor de despliegue. OJO: aquí NO se registra ningún Servlet.
    Tomcat convierte cada .jsp en una clase automáticamente; los controladores
    son archivos .jsp dentro de /Controllers.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

    <display-name>Emisora - CRUD JSP sin Servlet</display-name>

    <!-- Tildes y eñes correctas en formularios (POST) y respuestas -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <!-- Fragmentos incluidos con include (ej. WEB-INF/jspf/html.jspf) -->
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <!-- Quita las líneas en blanco que dejan las directivas <%@ ... %> -->
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!-- La sesión (usuario logueado) expira tras 30 minutos sin actividad -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
